if(DEFINED ENV{SSMT_CONTEXT_TEST_HARDWARE})
    message(FATAL_ERROR "参数纹理回归只允许 WARP，不使用硬件 GPU。")
endif()
get_filename_component(base "${RUNTIME}" DIRECTORY)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(stage "${base}/run-${run_id}")
file(MAKE_DIRECTORY "${stage}")
file(COPY "${RUNTIME}" DESTINATION "${stage}")
execute_process(COMMAND "${FIXTURE}" "${stage}/d3d11.dll" "${MODE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 25)
message("${output}${errors}")
if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "per-device IniParams checks completed: PASS")
    message(FATAL_ERROR "参数纹理与头像重绘回归失败：${result}")
endif()
