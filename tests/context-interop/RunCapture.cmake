if(DEFINED ENV{SSMT_CONTEXT_TEST_HARDWARE})
    message(FATAL_ERROR "帧分析回归只允许 WARP，不使用硬件 GPU。")
endif()
set(ENV{SSMT_CONTEXT_TEST_CAPTURE} 1)
unset(ENV{SSMT_CONTEXT_TEST_PRESENT1})
unset(ENV{SSMT_CONTEXT_TEST_DEFERRED})
if(API STREQUAL "Present1")
    set(ENV{SSMT_CONTEXT_TEST_PRESENT1} 1)
elseif(API STREQUAL "Deferred")
    set(ENV{SSMT_CONTEXT_TEST_DEFERRED} 1)
endif()
get_filename_component(base "${RUNTIME}" DIRECTORY)
# 独立运行目录避免 Runtime 的秒级目录名在快速重复测试时冲突。
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(stage "${base}/run-${run_id}")
file(MAKE_DIRECTORY "${stage}")
file(COPY "${RUNTIME}" "${base}/d3dx.ini" DESTINATION "${stage}")
set(RUNTIME "${stage}/d3d11.dll")
execute_process(COMMAND "${FIXTURE}" "${RUNTIME}" 0
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 25)
message("${output}${errors}")
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "帧分析夹具运行失败：${result}")
endif()
file(GLOB captures "${stage}/FrameAnalysis-*")
list(LENGTH captures count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "预期新建一个采集目录，实际为 ${count}。")
endif()
list(GET captures 0 capture)
file(GLOB_RECURSE buffers "${capture}/*-vb0=*.buf")
list(LENGTH buffers count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "重复 Present 后应完整采集一次 Draw，实际 VB 文件数为 ${count}。")
endif()
list(GET buffers 0 buffer)
file(SIZE "${buffer}" size)
if(NOT size EQUAL 48)
    message(FATAL_ERROR "VB 应有 3 个 16 字节顶点，实际为 ${size} 字节。")
endif()
file(GLOB logs "${capture}/log*.txt")
set(log "")
foreach(path IN LISTS logs)
    file(READ "${path}" content)
    string(APPEND log "${content}")
endforeach()
if(NOT log MATCHES "Draw\\(VertexCount:3" OR NOT log MATCHES "Dumping Buffer")
    message(FATAL_ERROR "采集日志缺少 Draw 或文件映射。")
endif()
message(STATUS "重复空 Present 后采集仍有效，且只保存一次 Draw。")
