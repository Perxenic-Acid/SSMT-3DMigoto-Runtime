execute_process(COMMAND "${FIXTURE}" "${RUNTIME}" WORKING_DIRECTORY "${STAGE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "${output}\n${error}")
endif()
file(READ "${STAGE}/d3d11_log.txt" log)
string(REGEX MATCHALL "SSMT overlay: Microsoft YaHei atlas cached" builds "${log}")
list(LENGTH builds count)
if(LANGUAGE STREQUAL "zh_s" AND NOT count EQUAL 1)
    message(FATAL_ERROR "32 次 Present 应只创建一次中文字库，实际 ${count} 次。\n${log}")
elseif(LANGUAGE STREQUAL "en" AND NOT count EQUAL 0)
    message(FATAL_ERROR "英文模式不应初始化中文字体。")
endif()
message(STATUS "${output}")
