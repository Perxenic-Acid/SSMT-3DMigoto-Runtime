if(DEFINED ENV{SSMT_CONTEXT_TEST_HARDWARE})
    message(FATAL_ERROR "帧命令归属回归只允许 WARP。")
endif()
get_filename_component(base "${RUNTIME}" DIRECTORY)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(stage "${base}/run-${run_id}")
file(MAKE_DIRECTORY "${stage}")
file(COPY "${RUNTIME}" DESTINATION "${stage}")
execute_process(COMMAND "${FIXTURE}" "${stage}/d3d11.dll" "${ORDER}" "${API}" "${INTERFACE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 25)
message("${output}${errors}")
if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "global frame resource checks completed: PASS")
    message(FATAL_ERROR "多设备帧命令回归失败：${result}")
endif()
file(READ "${stage}/d3d11_log.txt" log)
if(log MATCHES "Device mismatch, transferring" OR log MATCHES "Failed to substantiate")
    message(FATAL_ERROR "仍存在跨设备资源迁移或资源创建失败。")
endif()
